{
  "name": "deepseek-to-doc",
  "version": "1.1.0",
  "private": true,
  "description": "把 DeepSeek 分享链接转换成按日期排版的 HTML / Markdown 文档（前端：GitHub Pages；后端：Cloudflare Worker，见 README）",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test",
    "build:worker": "esbuild backend/worker.js --bundle --format=esm --platform=browser --outfile=worker.bundle.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "marked": "^12.0.2"
  }
}
